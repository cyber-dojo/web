<script>
'use strict';
$(() => {

  cd.setupHomeIcon();
	
  const $title = $('.title');
  const type = cd.urlParam('type');
  
  if (type != undefined) {
	$title.text(`created a new ${type} practice`);
  } else {
	$title.text('enter an existing practice');
  }
  
  const $idInput = $('input#id');
  const $waitSpinner = $('.wait-spinner');
  const $phoneticId = $('.phonetic-id');
  const $openSingleButton = $('button.enter.single');
  const $ltfGroups = $('.ltf-groups');

  let id = $idInput.val();
  let idType = undefined;

  $idInput.isDisabled = () => $idInput.attr('disabled');
  $idInput.disable = () => $idInput.attr('disabled',  true);
  $idInput.enable  = () => $idInput.attr('disabled', false);

  const showPhoneticId = () => {
    $phoneticId.show().html(phoneticSpelling(id).join('&nbsp;&nbsp;'));
  };

  // Pops up, over this page, the dialog saying a group has no avatars left.
  const showFullDialog = () => {
    const html = '<img src="/images/avatars/all_colour.png" class="avatars"/>';
    cdDialog(html, "sorry, it's full").showModal();
  };

  // Pops up, over this page, the 8x8 avatars of groupId: those already
  // started in colour (clicking one reopens its kata in a new tab), the rest
  // grey. With none started, its title says no one has joined yet.
  const showJoinDialog = (groupId) => {
    const route = cd.mountedPath(`/group_joined?id=${encodeURIComponent(groupId)}`);
    $.getJSON(route, (joined) => {
      $.getJSON('/images/avatars/names.json', (names) => {
        let dialog = undefined;
        const $avatar = (index) => {
          const kataId = joined.avatars[index];
          const $img = $('<img>', { src: `/images/avatars/${index}.jpg`, alt: names[index] });
          if (kataId) {
            $img.addClass('small colour avatar').attr('data-tip', names[index]);
            cd.setupHoverTips($img);
            $img.click(() => {
              cd.windowOpen(`/kata/edit/${kataId}`);
              dialog.close();
            });
          }
          else {
            $img.addClass('small grey avatar');
          }
          return $img;
        };
        const $table = $('<table>', { 'class': 'join-avatars' });
        for (let y = 0; y < 8; y++) {
          const $row = $('<tr>');
          for (let x = 0; x < 8; x++) {
            $row.append($('<td>').append($avatar(y * 8 + x)));
          }
          $table.append($row);
        }
        const anyStarted = Object.keys(joined.avatars).length > 0;
        dialog = cdDialog($table, anyStarted ? 'click your avatar' : "no one's joined yet!");
        dialog.showModal();
      });
    });
  };

  // Returns one LTF group's block: its LTF (language + test-framework) name as
  // a title, then its [enter] and [join] buttons side by side on one row,
  // which act on that group.
  const $ltfGroup = (groupId, displayName) => {
    const $enter = $('<button>', { 'type': 'button', 'class': 'medium enter group' })
      .html('start as <u>new</u> avatar');
    // A new avatar's kata opens in a new tab. A full group closes that tab
    // again and says so in a dialog, leaving this page as it is.
    $enter.click(() => {
      const tab = cd.openBlankTab();
      const json = JSON.stringify({ 'id': groupId });
      $.post(cd.mountedPath('/enter.json'), json, (response) => {
        if (response.full) {
          tab.close();
          showFullDialog();
        }
        else {
          tab.location = `/kata/edit/${response.id}`;
        }
      });
    });
    const $join = $('<button>', { 'type': 'button', 'class': 'medium reenter group' })
      .html('join as <u>existing</u> avatar');
    $join.click(() => showJoinDialog(groupId));
    return $('<div>', { 'class': 'ltf-group' }).append(
      $('<div>', { 'class': 'ltf-name' }).text(displayName),
      $('<div>', { 'class': 'ltf-buttons' }).append($enter, $join));
  };

  // Shows one block per LTF group, stacked: a bare group has one, a cluster
  // one per child group. Below them a single button opens the dashboard of
  // dashboardId (the group, or the whole cluster).
  const showLtfGroups = (groups, dashboardId) => {
    $ltfGroups.empty();
    groups.forEach((group) => $ltfGroups.append($ltfGroup(group.id, group.display_name)));
    const $dashboard = $('<button>', { 'type': 'button', 'class': 'medium open dashboard' })
      .text('open dashboard');
    $dashboard.click(() => cd.windowOpen(`/dashboard/show/${dashboardId}`));
    $ltfGroups.append($dashboard).show();
  };

  const showGroup = () => {
    const groupId = id;
    const route = cd.mountedPath(`/group_display_name?id=${urlId()}`);
    $.get(route, (response) =>
      showLtfGroups([{ 'id': groupId, 'display_name': response.display_name }], groupId));
  };

  const showCluster = () => {
    const clusterId = id;
    const route = cd.mountedPath(`/cluster_children?id=${urlId()}`);
    $.get(route, (response) => showLtfGroups(response.children, clusterId));
  };

  const hideAllButtons = () => {
    $openSingleButton.hide();
    $ltfGroups.empty().hide();
  };

  const setButtonStates = () => {
    id = $idInput.val();
    if (id.length < 6) {
      $idInput.removeClass('invalid');
      $phoneticId.hide();
      hideAllButtons();
      return;
    }
    if (id.length > 6) {
      $idInput.addClass('invalid');
      $phoneticId.hide();
      hideAllButtons();
      return;
    }
    $waitSpinner.fadeIn('fast', () => {
      const route = cd.mountedPath(`/id_type?id=${encodeURIComponent(id)}`);
      $.get(route, (response) => {
        idType = response.id_type;
        $waitSpinner.fadeOut('fast', () => {
          hideAllButtons();
          if (idType) {
            $idInput.removeClass('invalid');
            showPhoneticId();
            if (idType === 'group') {
              showGroup();
            }
            if (idType === 'single') {
              // display:block puts the button on its own row, directly below
              // the id entry field, so it is a short mouse move from typing.
              $openSingleButton.show().css('display', 'block');
              $openSingleButton.attr('href', `/kata/edit/${urlId()}`);
              $openSingleButton.attr('target', "_blank");
            }
            if (idType === 'cluster') {
              showCluster();
            }
          } else {
            $idInput.addClass('invalid');
            $phoneticId.hide();
          }
        });
      });
    });
  };

  const idInputChange = () => {
    if ($idInput.val() === id) {
      return;
    } else {
      setButtonStates();
    }
  };

  const urlId = () => encodeURIComponent(id);

  $idInput.keyup(() => idInputChange()).focus();

  $openSingleButton.click   (() => {
      cd.windowOpen(`/kata/edit/${urlId()}`);
      $('.home-icon').click();
  });

  setButtonStates();

});
</script>

<div id="enter-page">
  <div class="edged-panel">
    <div class="title"></div>
    <div class="sub-title">the ID of your practice is...</div>
    <input type="text" id="id" placeholder="??????" value="<%= @id %>"></input>
    <img class="wait-spinner" src="/images/rotate-cyber-dojo.gif">
    <div class="phonetic-id"></div>
    <div class="ltf-groups" style="display:none;"></div>
    <button type="button" class="large enter single" style="display:none;">ok</button>
  </div>
</div>
