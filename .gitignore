# ignore everything
/*
/*/

# except these dirs...

!/.github
!/app-creator
!/app-dashboard
!/app-web
!/bin
!/deployment
!/flow-templates

# but still ignore these generated dirs inside them...

/app-creator/reports/
/app-creator/test/evidence.json
/app-creator/test/server/reports/
/app-creator/test/client/reports/
/app-dashboard/reports/
/app-web/reports/

# and these files...

!/.dockerignore
!/.gitignore
!/CONTRIBUTING.md
!/docker-compose.yml
!/docker-compose-depends.yml
!/docker-compose-nginx.yml
!/docker-compose-selenium.yml
!/Dockerfile
!/LICENSE.md
!/Makefile
!/README.md
