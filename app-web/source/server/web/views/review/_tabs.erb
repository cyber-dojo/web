<div class="tab-filenames">
  <div class="tab filename"></div>
  <div class="tab output">output</div>
</div>

<script>
'use strict';
$(() => {

  const review = cd.review;

  // The two tabs over the diff sheet, as the kata page has over its editor:
  // the selected file's name, and a test run's output.
  // Not review.page, which is not yet set when these clicks are bound.
  const $filenameTab = () => $('#review-page .tab.filename');
  const $outputTab = () => $('#review-page .tab.output');

  review.tabs = {
    // The tabs take the theme setting, as the diff sheet beneath them does,
    // and follow it when the edit page's settings change it.
    theme: (value) => $('#review-page .tab').removeClass('light dark').addClass(value),
    // Names the file the filename tab returns to.
    setFilename: (filename) => $filenameTab().text(filename),
    selectFilename: () => select($filenameTab()),
    selectOutput: () => select($outputTab()),
    // Only an event with output has an output tab.
    showOutput: () => $outputTab().show(),
    hideOutput: () => $outputTab().hide()
  };

  review.tabs.theme(cd.settings.theme());

  const select = ($tab) => {
    $('#review-page .tab').removeClass('selected');
    $tab.addClass('selected');
  };

  $filenameTab().click(() => {
    if (review.selectedDiff) {
      review.selectFilename(review.selectedDiff);
    }
  });

  $outputTab().click(() => review.selectOutput());

});
</script>
