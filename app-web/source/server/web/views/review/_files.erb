<div id="diff-filenames"></div>

<script>
'use strict';
$(() => {

  const review = cd.review;

  review.files = {
    refresh: () => {
      const args = {
        id:review.id,
        was_index:previousIndex(review.index),
        now_index:review.index
      };
      return review.getJSON('kata', 'diff_lines', args, (diffs) => {
        augmentDiffs(diffs);
        review.refreshFilenames(diffs);
        filesRefresher(diffs);
      });
    }
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  const previousIndex = (index) => {
    if (review.diffRadio.isOff()) {
      return index;
    } 
    else {
      return review.previousIndex(index);
    }
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  const filesRefresher = (diffs) => {
    const $diffContent = $('#diff-content');
    $diffContent.html(makeDiffContent(diffs));
    const picked = review.pickFile(diffs, review.filename);
    // Detailed mode shows a test run's output, the filename tab still naming
    // the picked file. Selecting the output here, before the output itself
    // refreshes, keeps the picked file from showing in between.
    if (review.diffRadio.isDetailed() && review.output.hasOutput(review.currentEvent())) {
      review.tabs.setFilename(picked.filename);
      review.selectedDiff = picked;
      review.selectOutput();
    }
    else {
      review.selectFilename(picked);
    }
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  const augmentDiffs = (diffs) => {
    diffs.forEach((diff, index) => {
      diff.id = `id_${index}`;
      diff.chunkIndex = 0
      diff.chunkCount = chunkCount(diff.lines);
      diff.hasBeenClicked = false;
      diff.filename = (diff.type == 'deleted') ? diff.old_filename : diff.new_filename;
    });
  };

  const chunkCount = (lines) => lines.reduce((n,line) => n + (line.type == 'section'), 0);

  // - - - - - - - - - - - - - - - - - - - - - - - -
  review.makeDiffFileContent = (diff) => {
    const lineNumbers = makeLineNumbers(diff.lines);
    const fileContent = makeContent(diff);
    const $file = $('' +
      `<div id="file-content-${diff.id}" class="file-content">` +
      '<table>' +
        '<tr class="valign-top">' +
          makeTd('<div class="diff-line-numbers"></div>') +
          makeTd(`<div id="diff-sheet-${diff.id}"` +
                 ` class="diff-sheet ${sheetThemeClass()}"></div>`) +
        '</tr>' +
      '</table>' +
      '</div>'
      );
    const $numbers = $('.diff-line-numbers', $file);
    $numbers.html(lineNumbers);

    const $content = $('.diff-sheet', $file);
    $content.html(fileContent);

    bindLineNumberScrolling($content, $numbers);
    return $file;
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  // The CodeMirror theme class colouring a sheet's tokens. A sheet is always
  // white, so it takes the light theme whatever the theme setting.
  const sheetThemeClass = () => `cm-s-cyber-dojo-light-colour-${cd.settings.colour()}`;

  // - - - - - - - - - - - - - - - - - - - - - - - -
  const makeDiffContent = (diffs) => {
    const $holder = $('<span>');
    diffs.forEach(diff => $holder.append(review.makeDiffFileContent(diff)));
    return $holder;
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  const makeLineNumbers = (lines) => {
    let html = [];
    lines.forEach(line => {
      if (line.type != 'section') {
        html.push(`<${line.type}><ln>${line.number}</ln></${line.type}>`);
      }
    });
    return html;
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  const makeContent = (diff) => {
    // Each side is highlighted as a whole file, so a construct spanning
    // several lines (eg a block comment) is tokenised as its own side sees it.
    const mode = cd.codeMirror.mode(diff.filename);
    const oldLines = highlightedLines(sideText(diff.lines, 'added'), mode);
    const newLines = highlightedLines(sideText(diff.lines, 'deleted'), mode);
    let oldIndex = 0;
    let newIndex = 0;
    let html = [];
    diff.lines.forEach(diff_line => {
      if (diff_line.type == 'section') {
        html.push(`<span id='diff-chunk-${diff.id}-${diff_line.index}'></span>`);
      }
      else {
        let line;
        if (diff_line.type == 'deleted') {
          line = oldLines[oldIndex++];
        }
        else if (diff_line.type == 'added') {
          line = newLines[newIndex++];
        }
        else {
          line = newLines[newIndex++];
          oldIndex++;
        }
        if (line == '') { line = '&nbsp'; }
        html.push(`<${diff_line.type}>${line}</${diff_line.type}>`);
      }
    });
    return html;
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  // The text of one side of a diff: every line except the other side's
  // own lines (otherType) and the section markers.
  const sideText = (diff_lines, otherType) => {
    return diff_lines
      .filter(diff_line => diff_line.type != 'section' && diff_line.type != otherType)
      .map(diff_line => diff_line.line)
      .join('\n');
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  // The html of each line of text, its tokens wrapped in CodeMirror's
  // cm-<style> spans, which the CodeMirror theme classes colour.
  const highlightedLines = (text, mode) => {
    const lines = text.split('\n').map(() => '');
    CodeMirror.runMode(text, mode, (token, style, lineIndex) => {
      if (token == '\n') { return; }
      const escaped = cd.htmlEscape(token);
      if (style) {
        const classes = 'cm-' + style.replace(/ +/g, ' cm-');
        lines[lineIndex] += `<span class="${classes}">${escaped}</span>`;
      }
      else {
        lines[lineIndex] += escaped;
      }
    });
    return lines;
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  const bindLineNumberScrolling = ($content, $numbers) => {
    const synchScroll = () => $numbers.scrollTop($content.scrollTop());
    $content.bind({
      keydown   : synchScroll,
      scroll    : synchScroll,
      mousewheel: synchScroll,
      mousemove : synchScroll,
      mousedown : synchScroll,
      mouseup   : synchScroll
    });
  };

  // - - - - - - - - - - - - - - - - - - - - - - - -
  const makeTd = (html) => `<td>${html}</td>`;

});
</script>
