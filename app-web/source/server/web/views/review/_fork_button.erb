<button id="fork-button" type="button" class="lockable">fork</button>

<dialog id="fork-dialog" style="width:320px">
  <header>
    <span class="dialog-title">fork</span>
    <button type="button" class="dialog-close">close</button>
  </header>
  <div class="info">
    create a new practice<br/>
    from this traffic-light's files
  </div>
  <button class="group" type="button">
    <span class="fork-option-name">group</span>
    <ul>
      <li>Everyone gets an avatar</li>
      <li>One shared dashboard</li>
    </ul>
  </button>
  <button class="kata" type="button">
    <span class="fork-option-name">solo</span>
    <ul>
      <li>No avatar</li>
      <li>No dashboard</li>
    </ul>
  </button>
  <button class="avatar" type="button">
    <span class="fork-option-name">avatar</span>
    <ul>
      <li>A new avatar in this group</li>
      <li>Same dashboard</li>
    </ul>
    <span class="fork-option-note" style="display:none">this group is full</span>
  </button>
</dialog>

<script>
'use strict';
// Inline (not $()) so document.currentScript is available, letting each partial
// instance wire its own sibling button and dialog without a guard against
// double-initialization when the partial appears twice on the same page.
(function() {
  const dialog = document.currentScript.previousElementSibling;
  const button = dialog.previousElementSibling;

  const kata = cd.kata;
  const review = cd.review;

  //- - - - - - - - - - - - - - - - - - - - - - - - -
  // NB: logically there are other possibilities here...
  // - In a classroom practice, you could fork a new avatar (in that group)
  // - A "Deep-Fork" where the new session has the full git
  //   history of the forked-from session.
  // At present, there is no support for either of these.

  const refreshToolTip = () => {
    cd.createTip($(button), () => {
      return `Create a <u>new</u> practice from<br/>${review.nameRagColour()}`;
    });
  };

  // A pulling, timed_out or faulty light is not a test result, so there is
  // nothing in it to fork.
  const isOnNonTestResult = () =>
    ['pulling', 'timed_out', 'faulty'].includes(review.currentEvent().colour);

  review.forkButton = {
    enable: () => $(button).prop('disabled', false),
    disable: () => $(button).prop('disabled', true),
    refresh: () => {
      refreshToolTip();
      if (cd.env['FORK_BUTTON'] == 'off') {
        $(button).hide();
      }
      if (cd.mobbingPoll.locked) {
        review.forkButton.disable();
        return;
      }
      if (review.isOnFileEvent() || isOnNonTestResult()) {
        review.forkButton.disable();
      }
      else {
        review.forkButton.enable();
      }
    }
  };

  $('.dialog-close', dialog).click(() => dialog.close());

  //- - - - - - - - - - - - - - - - - - - - - - - - -

  const openForkDialog = () => {
    // Only a traffic-light of a kata in a group can start a new avatar in that
    // group, and only while the group has fewer than its 64 avatars.
    const $avatar = $('.avatar', dialog);
    const inGroup = cd.kata.manifest().group_index !== undefined &&
                    !cd.lib.isCreationEvent(review.currentEvent());
    $avatar.toggle(inGroup);
    if (inGroup) {
      review.getJSON('saver', 'group_joined', { id: review.id }, (joined) => {
        const full = Object.keys(joined).length === 64;
        $avatar.prop('disabled', full);
        $('.fork-option-note', $avatar).toggle(full);
      });
    }
    const rect = button.getBoundingClientRect();
    dialog.style.left = rect.left + 'px';
    dialog.style.top = (rect.top + 30) + 'px';
    dialog.style.margin = '0';
    dialog.showModal();
  };

  // A new kata or group opens on the creator's enter page; a new avatar has
  // already joined its group, so it opens straight in the edit page.
  const enterPage = (id) => `/creator/enter?id=${id}`;
  const editPage = (id) => `/kata/edit/${id}`;

  const showFullDialog = () => {
    const html = '<img src="/images/avatars/all_colour.png" class="avatars"/>' +
                 '<div>fork as a new group instead</div>';
    cd.dialog(html, "sorry, it's full").showModal();
  };

  const fork = (url, responseKey, pageFor) => {
    dialog.close();
    const params = new URLSearchParams({ id: review.id, index: review.index });
    fetch(`${url}?${params}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      }
    })
    .then(r => r.json())
    .then(response => {
      const id = response[responseKey];
      if (id) {
        window.open(pageFor(id));
      } else if (responseKey in response) {
        // Saver answers null, not an error, when the group has filled since
        // the dialog opened. As the creator does, say so.
        showFullDialog();
      } else {
        cd.dialogError(response);
      }
    })
    .catch(err => cd.dialogError(err.toString()));
  };

  //- - - - - - - - - - - - - - - - - - - - - - - - -
  $(button).click(() => openForkDialog());
  $('.kata',   dialog).click(() => fork('/fork/kata',   'kata_fork',   enterPage));
  $('.group',  dialog).click(() => fork('/fork/group',  'group_fork',  enterPage));
  $('.avatar', dialog).click(() => fork('/fork/avatar', 'avatar_fork', editPage));

})();
</script>
