<script>
'use strict';
$(() => {

  const review = cd.review;

  review.output = {
    // Only a test run has output. Any other event (eg the kata's creation)
    // empties the output's content and hides its tab, so no earlier run's
    // output lingers to be shown.
    hasOutput: (event) => cd.lib.isLight(event) && !cd.lib.isCreationEvent(event),
    refresh: () => {
      const event = review.currentEvent();
      if (review.output.hasOutput(event)) {
        return review.getJSON('saver', 'kata_event', { id:review.id, index:review.index }, (event) => {
          outputRefresher(event);
        });
      }
      else {
        review.tabs.hideOutput();
        $('#diff-content-output').empty();
        return Promise.resolve();
      }
    }
  };

  // Shows the output's content and selects the output tab, leaving the
  // filename tab naming the file it returns to.
  review.selectOutput = () => {
    $('.diff-filename', review.page).removeClass('selected');
    $('.file-content', review.page).hide();
    $('#file-content-output', review.page).show();
    review.tabs.selectOutput();
    review.filename = 'output';
  };

  //- - - - - - - - - - - - - - - - - - - - - - - - -
  const outputRefresher = (event) => {
    // stdout and stderr share one sheet, stderr lines styled apart by
    // their own line type. status sits in a bar below the sheet.
    const stdout = textLines(event.stdout.content);
    const stderr = textLines(event.stderr.content);
    // Real file diffs have an id of the form id_N so 'output' never clashes.
    const output = {
            id: 'output',
          type: '',
      filename: 'output',
         lines: [
           ...stdout.map((line, n) => makeLine('same',   line, n + 1)),
           ...stderr.map((line, n) => makeLine('stderr', line, stdout.length + n + 1))
         ]
    };
    const $output = review.makeDiffFileContent(output);
    $output.append($('<div>', { class:'output-status', text:`status ${event.status}` }));

    const $diffContentOutput = $('#diff-content-output');
    $diffContentOutput.empty().append($output);
    review.tabs.showOutput();
    if (review.diffRadio.isDetailed()) {
      review.selectOutput();
    }
    else if (review.filename !== output.filename) {
      $output.hide();
    }
  };

  // The lines of a stream with trailing whitespace dropped; none when empty.
  const textLines = (s) => {
    const stripped = s.replace(/\s+$/, '');
    if (stripped === '') {
      return [];
    }
    else {
      return stripped.split(/\r?\n/);
    }
  };

  const makeLine = (type, line, number) => {
    return { type:type, line:line, number:number };
  };

});
</script>
