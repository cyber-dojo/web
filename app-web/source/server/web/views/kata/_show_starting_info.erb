<script>
'use strict';
$(() => {

  // Show the starting-info when a freshly-created kata is opened, ie when the
  // only committed event is the create event (eventCount 1).
  cd.showStartingInfoDialog = (eventCount) => {
    const theDefault = 'on';
    if (eventCount === 1 && cd.lib.setting('starting_info_dialog',theDefault) === 'on') {
      // The kata opens in a new tab with no click to give it keyboard focus;
      // focusing the window is what lets the Escape key close the dialog.
      window.focus();
      // The panel slides out too, so the traffic-lights button shows
      // selected beside the dialog it opens.
      cd.openMorePanel(() => cd.trafficLightsButton().click());
    }
  };

});
</script>
