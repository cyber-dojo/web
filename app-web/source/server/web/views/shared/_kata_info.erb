<button type="button" id="kata-info-button" class="info-button opens-dialog">this practice</button>

<dialog id="kata-info-dialog" style="width:400px">
  <header>
    <%= partial('shared/dialog_close_x') %>
    <span class="dialog-title">this practice</span>
  </header>
  <div class="info">
    <table class="kata-facts">
      <tr><td>ID</td><td class="kata-id"></td></tr>
      <tr class="kata-avatar-row" style="display:none;"><td>avatar</td><td class="kata-avatar"></td></tr>
      <tr class="kata-ltf-row"><td>exercise</td><td class="kata-exercise"></td></tr>
      <tr class="kata-ltf-row"><td>language</td><td class="kata-language"></td></tr>
      <tr class="kata-ltf-row"><td>test framework</td><td class="kata-test-framework"></td></tr>
      <tr class="kata-setup-row"><td>setup</td><td class="kata-setup"></td></tr>
    </table>
  </div>
</dialog>

<script>
'use strict';
// Inline (not $()) so document.currentScript is available, letting each partial
// instance wire its own sibling button and dialog.
(function() {
  const dialog = document.currentScript.previousElementSibling;
  const button = dialog.previousElementSibling;
  $(dialog).on('close', () => { if (cd.kata && cd.kata.editor) cd.kata.editor.refocus(); });
  $('.dialog-close', dialog).click(() => dialog.close());
  // Returns a [name, version] pair as eg 'Python 3.14.3'.
  const nameVersion = (pair) => pair.filter(Boolean).join(' ');
  // Returns s split at its first two commas, at most three trimmed parts.
  const splitAtFirstTwoCommas = (s) => {
    const parts = s.split(',');
    const firstThree = parts.length <= 3 ? parts : [parts[0], parts[1], parts.slice(2).join(',')];
    return firstThree.map((part) => part.trim());
  };
  // Fills the facts panel from the kata's manifest. A kata whose manifest has
  // language and test_framework [name, version] pairs shows exercise,
  // language and test framework rows (a skipped exercise is ''). Without
  // them (custom katas, and older ones) nothing says which part of its
  // display_name is which, so one setup row shows its exercise, if any, then
  // its display_name split at the first two commas, one part per line.
  // Only a kata in a group has a group_index, the index of its avatar, and
  // only then is the avatar row shown, its name tipping the avatar's image.
  const showFacts = () => {
    const manifest = cd.kata.manifest();
    $('.kata-id', dialog).text(cd.kata.id);
    cd.createTip($('.kata-id', dialog), phoneticSpelling(cd.kata.id).join('&nbsp;&nbsp;'));
    const avatarIndex = manifest.group_index;
    if (avatarIndex != undefined) {
      const $avatar = $('.kata-avatar', dialog).text(cd.lib.avatarName(avatarIndex));
      cd.createTip($avatar, `<img class="avatar-tip" src="/images/avatars/${avatarIndex}.jpg">`);
      $('.kata-avatar-row', dialog).show();
    }
    const hasLtf = Array.isArray(manifest.language) && Array.isArray(manifest.test_framework);
    $('.kata-ltf-row', dialog).toggle(hasLtf);
    $('.kata-setup-row', dialog).toggle(!hasLtf);
    if (hasLtf) {
      $('.kata-exercise', dialog).text(manifest.exercise || '(none)');
      $('.kata-language', dialog).text(nameVersion(manifest.language));
      $('.kata-test-framework', dialog).text(nameVersion(manifest.test_framework));
    }
    else {
      const lines = [manifest.exercise, ...splitAtFirstTwoCommas(manifest.display_name)].filter(Boolean);
      $('.kata-setup', dialog).empty().append(lines.map((line) => $('<div>').text(line)));
    }
  };
  $(button).click(() => {
    showFacts();
    cd.showPanelDialog(button, dialog);
  });
})();
</script>
