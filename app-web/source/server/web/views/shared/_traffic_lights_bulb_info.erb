Each test run creates a new traffic-light:
<table class="traffic-light-rows">
  <tr>
    <td>&nbsp;&nbsp;&nbsp;</td>
    <td class="colour-name"><span class="red">red</span></td>
    <td>
      <img src='/images/traffic-light/red.png'
           alt='red traffic-light'
           class='traffic-light'
           style="vertical-align:middle" />
    </td>
    <td>some tests failed</td>
  </tr>
  <tr>
    <td>&nbsp;&nbsp;&nbsp;</td>
    <td class="colour-name"><span class="amber">amber</span></td>
    <td>
      <img src='/images/traffic-light/amber.png'
           alt='amber traffic-light'
           class='traffic-light'
           style="vertical-align:middle" />
    </td>
    <td>tests did not run</td>
  </tr>
  <tr>
    <td>&nbsp;&nbsp;&nbsp;</td>
    <td class="colour-name"><span class="green">green</span></td>
    <td>
      <img src='/images/traffic-light/green.png'
           alt='green traffic-light'
           class='traffic-light'
           style="vertical-align:middle" />
    </td>
    <td>all tests passed</td>
  </tr>
</table>