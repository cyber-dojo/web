<button type="button" id="traffic-lights-button" class="info-button opens-dialog">traffic-lights</button>

<dialog id="traffic-lights-dialog" style="width:400px">
  <header>
    <span class="dialog-title"><%= partial('shared/more_mark') %>traffic-lights</span>
    <button type="button" class="dialog-close">close</button>
  </header>
  <div class="info">
    <%= partial('shared/traffic_lights_bulb_info') %>
  </div>
  <div class="info">
    <%= partial('shared/traffic_lights_click_info') %>
  </div>
</dialog>

<script>
'use strict';
// Inline (not $()) so document.currentScript is available, letting each partial
// instance wire its own sibling button and dialog.
(function() {
  const dialog = document.currentScript.previousElementSibling;
  const button = dialog.previousElementSibling;
  // A new kata opens with this dialog showing (see _show_starting_info.erb).
  cd.trafficLightsButton = () => $(button);
  $(dialog).on('close', () => { if (cd.kata && cd.kata.editor) cd.kata.editor.refocus(); });
  $('.dialog-close', dialog).click(() => dialog.close());
  $(button).click(() => cd.showPanelDialog(button, dialog));
})();
</script>
